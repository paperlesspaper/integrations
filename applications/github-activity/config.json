{
  "name": "GitHub Activity",
  "version": "0.1.0",
  "status": "alpha",
  "description": "A contribution calendar with annual total, visible total and active days.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "green-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "token": "",
    "username": "",
    "weeks": 26
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "token": {
        "type": "string",
        "title": "GitHub access token",
        "default": "",
        "format": "password"
      },
      "username": {
        "type": "string",
        "title": "GitHub username",
        "default": ""
      },
      "weeks": {
        "type": "number",
        "title": "Visible weeks",
        "default": 26,
        "minimum": 4,
        "maximum": 53
      }
    }
  },
  "configVariants": [
    {
      "color": "green-light",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "token": "",
      "username": "",
      "weeks": 26,
      "screenshots": {
        "800x480": "./screenshots/github-activity-light-800x480.png",
        "480x800": "./screenshots/github-activity-light-480x800.png",
        "1600x1200": "./screenshots/github-activity-light-1600x1200.png",
        "1200x1600": "./screenshots/github-activity-light-1200x1600.png"
      }
    },
    {
      "color": "green-dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "token": "",
      "username": "",
      "weeks": 26,
      "screenshots": {
        "800x480": "./screenshots/github-activity-dark-800x480.png",
        "480x800": "./screenshots/github-activity-dark-480x800.png",
        "1600x1200": "./screenshots/github-activity-dark-1600x1200.png",
        "1200x1600": "./screenshots/github-activity-dark-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "token": "",
      "username": "",
      "weeks": 26,
      "screenshots": {
        "800x480": "./screenshots/github-activity-black-800x480.png",
        "480x800": "./screenshots/github-activity-black-480x800.png",
        "1600x1200": "./screenshots/github-activity-black-1600x1200.png",
        "1200x1600": "./screenshots/github-activity-black-1200x1600.png"
      }
    }
  ]
}
