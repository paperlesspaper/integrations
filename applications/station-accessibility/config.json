      "screenshots": {
        "800x480": "./screenshots/station-accessibility-dark-800x480.png",
        "480x800": "./screenshots/station-accessibility-dark-480x800.png",
        "1600x1200": "./screenshots/station-accessibility-dark-1600x1200.png",
        "1200x1600": "./screenshots/station-accessibility-dark-1200x1600.png"
      }
