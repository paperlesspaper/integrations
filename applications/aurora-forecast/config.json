  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "locationName": {
        "type": "string",
        "title": "Location name",
        "default": "Tromsø"
      },
      "latitude": {
        "type": "number",
        "title": "Latitude",
        "default": 69.65,
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "title": "Longitude",
        "default": 18.96,
        "minimum": -180,
        "maximum": 180
      },
      "weatherApiKey": {
        "type": "string",
        "title": "Open-Meteo commercial API key (optional)",
        "default": "",
        "format": "password"
      }
    }
  },
