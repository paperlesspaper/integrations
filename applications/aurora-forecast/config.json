{
  "name": "Aurora Forecast",
  "version": "0.1.0",
  "status": "alpha",
  "description": "NOAA auroral oval model at your location with nighttime cloud forecast.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "green-light",
