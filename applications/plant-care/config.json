{
  "name": "Plant Care",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Watering and feeding reminders based on your own care schedule.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "green-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "plants": "[]"
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "plants": {
        "type": "string",
        "title": "Plants (JSON array)",
        "default": "[]",
        "format": "textarea",
        "maxLength": 40000,
        "inStettingsPage": true
      }
    }
  },
  "configVariants": [
    {
      "color": "green-light",
      "title": "",
