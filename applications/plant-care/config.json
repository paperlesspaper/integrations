        "480x800": "./screenshots/plant-care-light-480x800.png",
        "1600x1200": "./screenshots/plant-care-light-1600x1200.png",
        "1200x1600": "./screenshots/plant-care-light-1200x1600.png"
      }
    },
    {
      "color": "green-dark",
      "title": "",
