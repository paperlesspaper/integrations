{
  "name": "E-Bike Status",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Battery and ride telemetry from Home Assistant, including Specialized Turbo.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": [
    "de",
    "en"
  ],
  "nativeSettings": {
    "color": "green-light",
    "title": "",
    "sampleData": true,
    "baseUrl": "",
    "token": "",
    "batteryEntity": "",
    "distanceEntity": "",
    "chargingEntity": "",
    "bikeName": ""
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "",
        "title": "Display title",
        "maxLength": 80
      },
      "sampleData": {
        "type": "boolean",
        "default": true,
        "title": "Use clearly labelled demo data"
      },
      "baseUrl": {
        "type": "string",
        "default": "",
        "title": "Instance base URL",
        "format": "url"
      },
      "token": {
        "type": "string",
        "default": "",
        "title": "Access token",
        "format": "password"
      },
      "batteryEntity": {
        "type": "string",
        "default": "",
        "title": "Battery entity"
      },
      "distanceEntity": {
        "type": "string",
        "default": "",
        "title": "Distance entity (optional)"
      },
      "chargingEntity": {
        "type": "string",
        "default": "",
        "title": "Charging entity (optional)"
      },
      "bikeName": {
        "type": "string",
        "default": "",
        "title": "Bike name"
      }
    }
  },
  "configVariants": [
    {
      "color": "green-light",
      "title": "",
      "sampleData": true,
      "baseUrl": "",
      "token": "",
      "batteryEntity": "",
      "distanceEntity": "",
      "chargingEntity": "",
      "bikeName": "",
      "screenshots": {
        "800x480": "./screenshots/ebike-status-default-800x480.png",
        "480x800": "./screenshots/ebike-status-default-480x800.png",
        "1600x1200": "./screenshots/ebike-status-default-1600x1200.png",
        "1200x1600": "./screenshots/ebike-status-default-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "baseUrl": "",
      "token": "",
      "batteryEntity": "",
      "distanceEntity": "",
      "chargingEntity": "",
      "bikeName": "",
      "screenshots": {
        "800x480": "./screenshots/ebike-status-dark-800x480.png",
        "480x800": "./screenshots/ebike-status-dark-480x800.png",
        "1600x1200": "./screenshots/ebike-status-dark-1600x1200.png",
        "1200x1600": "./screenshots/ebike-status-dark-1200x1600.png"
      }
    }
  ]
}
