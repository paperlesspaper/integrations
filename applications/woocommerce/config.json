{
  "name": "WooCommerce Shop",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Orders, paid order value and pending shipments for WooCommerce.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "blue-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "storeUrl": "",
    "consumerKey": "",
    "consumerSecret": "",
    "days": 7,
    "currency": "EUR"
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "storeUrl": {
        "type": "string",
        "title": "WooCommerce store URL",
        "default": "",
        "format": "uri"
      },
      "consumerKey": {
        "type": "string",
        "title": "Read-only consumer key",
        "default": "",
        "format": "password"
      },
      "consumerSecret": {
        "type": "string",
        "title": "Consumer secret",
        "default": "",
        "format": "password"
      },
      "days": {
        "type": "number",
        "title": "Period including today (days)",
        "default": 7,
        "minimum": 1,
        "maximum": 30
      },
      "currency": {
        "type": "string",
        "title": "Display currency (ISO)",
        "default": "EUR"
      }
    }
  },
  "configVariants": [
    {
      "color": "blue-light",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "storeUrl": "",
      "consumerKey": "",
      "consumerSecret": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/woocommerce-light-800x480.png",
        "480x800": "./screenshots/woocommerce-light-480x800.png",
        "1600x1200": "./screenshots/woocommerce-light-1600x1200.png",
        "1200x1600": "./screenshots/woocommerce-light-1200x1600.png"
      }
    },
    {
      "color": "blue-dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "storeUrl": "",
      "consumerKey": "",
      "consumerSecret": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/woocommerce-dark-800x480.png",
        "480x800": "./screenshots/woocommerce-dark-480x800.png",
        "1600x1200": "./screenshots/woocommerce-dark-1600x1200.png",
        "1200x1600": "./screenshots/woocommerce-dark-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "storeUrl": "",
      "consumerKey": "",
      "consumerSecret": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/woocommerce-black-800x480.png",
        "480x800": "./screenshots/woocommerce-black-480x800.png",
        "1600x1200": "./screenshots/woocommerce-black-1600x1200.png",
        "1200x1600": "./screenshots/woocommerce-black-1200x1600.png"
      }
    }
  ]
}
