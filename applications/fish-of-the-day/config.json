{
  "name": "Fish of the Day",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Shows one deterministic daily prehistoric fish with generated CAD-like artwork and compact Wikipedia-sourced fossil facts.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "nativeSettings": {
    "color": "light",
    "group": "any",
    "fishId": "",
    "seed": "",
    "showPeriod": true,
    "showLength": true,
    "showDiet": true,
    "showFossilLocation": true,
    "showNameMeaning": true,
    "showSource": false,
    "textSize": "middle",
    "showHeader": true,
    "showFactCount": false,
    "showRotationCount": false
  },
  "configVariants": [
    {
      "color": "light",
      "group": "any",
      "fishId": "",
      "seed": "",
      "showPeriod": true,
      "showLength": true,
      "showDiet": true,
      "showFossilLocation": true,
      "showNameMeaning": true,
      "showSource": false,
      "textSize": "middle",
      "showHeader": true,
      "screenshots": {
        "800x480": "./screenshots/fish-of-the-day-default-800x480-landscape.png",
        "480x800": "./screenshots/fish-of-the-day-default-480x800-portrait.png",
        "1600x1200": "./screenshots/fish-of-the-day-default-1600x1200-landscape.png",
        "1200x1600": "./screenshots/fish-of-the-day-default-1200x1600-portrait.png"
      },
      "showFactCount": false,
      "showRotationCount": false
    },
    {
      "color": "dark",
      "group": "placoderm",
      "fishId": "dunkleosteus",
      "seed": "paperlesspaper",
      "showPeriod": true,
      "showLength": true,
      "showDiet": true,
      "showFossilLocation": true,
      "showNameMeaning": true,
      "showSource": true,
      "textSize": "middle",
      "showHeader": true,
      "screenshots": {
        "800x480": "./screenshots/fish-of-the-day-dunkleosteus-800x480-landscape.png",
        "480x800": "./screenshots/fish-of-the-day-dunkleosteus-480x800-portrait.png",
        "1600x1200": "./screenshots/fish-of-the-day-dunkleosteus-1600x1200-landscape.png",
        "1200x1600": "./screenshots/fish-of-the-day-dunkleosteus-1200x1600-portrait.png"
      },
      "showFactCount": false,
      "showRotationCount": false
    }
  ],
  "formSchema": {
    "type": "object",
    "properties": {
      "group": {
        "type": "string",
        "title": "Fish group",
        "enum": [
          "any",
          "placoderm",
          "lobe-finned",
          "ray-finned",
          "cartilaginous",
          "jawless"
        ],
        "default": "any"
      },
      "fishId": {
        "type": "string",
        "title": "Pinned fish",
        "description": "Optional fish slug, for example dunkleosteus, tiktaalik, megalodon, cretoxyrhina, hyneria, mawsonia, entelognathus, cephalaspis, saurichthys, enchodus, pycnodus, or coccosteus.",
        "default": ""
      },
      "seed": {
        "type": "string",
        "title": "Rotation seed",
        "description": "Optional text that creates a different daily fish rotation.",
        "default": ""
      },
      "showPeriod": {
        "type": "boolean",
        "title": "Show period",
        "default": true
      },
      "showLength": {
        "type": "boolean",
        "title": "Show length",
        "default": true
      },
      "showDiet": {
        "type": "boolean",
        "title": "Show diet",
        "default": true
      },
      "showFossilLocation": {
        "type": "boolean",
        "title": "Show fossil location",
        "default": true
      },
      "showNameMeaning": {
        "type": "boolean",
        "title": "Show name meaning",
        "default": true
      },
      "showSource": {
        "type": "boolean",
        "title": "Show source",
        "default": false
      },
      "textSize": {
        "type": "string",
        "title": "Text size",
        "enum": [
          "small",
          "middle",
          "big"
        ],
        "default": "middle",
        "description": "Larger text shows fewer facts when needed to keep the full image visible."
      },
      "showHeader": {
        "type": "boolean",
        "title": "Show header",
        "default": true
      },
      "showFactCount": {
        "type": "boolean",
        "title": "Show fact count",
        "description": "Show how many selected facts fit on the display. Hidden when all facts fit.",
        "default": false
      },
      "showRotationCount": {
        "type": "boolean",
        "title": "Show rotation count",
        "description": "Show the number of items in the current rotation. Requires the header to be enabled.",
        "default": false
      }
    }
  },
  "language": [
    "en",
    "de"
  ]
}
