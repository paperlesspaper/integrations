{
  "name": "Shopify Shop",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Orders, net payments and pending shipments for Shopify.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "green-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "shopDomain": "",
    "accessToken": "",
    "days": 7,
    "currency": "EUR"
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "shopDomain": {
        "type": "string",
        "title": "Shop domain (store.myshopify.com)",
        "default": ""
      },
      "accessToken": {
        "type": "string",
        "title": "Shopify Admin API access token",
        "default": "",
        "format": "password"
      },
      "days": {
        "type": "number",
        "title": "Period including today (days)",
        "default": 7,
        "minimum": 1,
        "maximum": 30
      },
      "currency": {
        "type": "string",
        "title": "Display currency (ISO)",
        "default": "EUR"
      }
    }
  },
  "configVariants": [
    {
      "color": "green-light",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "shopDomain": "",
      "accessToken": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/shopify-light-800x480.png",
        "480x800": "./screenshots/shopify-light-480x800.png",
        "1600x1200": "./screenshots/shopify-light-1600x1200.png",
        "1200x1600": "./screenshots/shopify-light-1200x1600.png"
      }
    },
    {
      "color": "green-dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "shopDomain": "",
      "accessToken": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/shopify-dark-800x480.png",
        "480x800": "./screenshots/shopify-dark-480x800.png",
        "1600x1200": "./screenshots/shopify-dark-1600x1200.png",
        "1200x1600": "./screenshots/shopify-dark-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "shopDomain": "",
      "accessToken": "",
      "days": 7,
      "currency": "EUR",
      "screenshots": {
        "800x480": "./screenshots/shopify-black-800x480.png",
        "480x800": "./screenshots/shopify-black-480x800.png",
        "1600x1200": "./screenshots/shopify-black-1600x1200.png",
        "1200x1600": "./screenshots/shopify-black-1200x1600.png"
      }
    }
  ]
}
