{
  "name": "Home Assistant Sensors",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Selected Home Assistant sensor and binary sensor states.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": [
    "de",
    "en"
  ],
  "nativeSettings": {
    "color": "blue-light",
    "title": "",
    "sampleData": true,
    "baseUrl": "",
    "token": "",
    "entities": ""
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "default": "",
        "title": "Display title",
        "maxLength": 80
      },
      "sampleData": {
        "type": "boolean",
        "default": true,
        "title": "Use clearly labelled demo data"
      },
      "baseUrl": {
        "type": "string",
        "default": "",
        "title": "Instance base URL",
        "format": "url"
      },
      "token": {
        "type": "string",
        "default": "",
        "title": "Access token",
        "format": "password"
      },
      "entities": {
        "type": "string",
        "default": "",
        "title": "Entity IDs, one per line (sensor.* or binary_sensor.*)",
        "format": "textarea",
        "maxLength": 1500
      }
    }
  },
  "configVariants": [
    {
      "color": "blue-light",
      "title": "",
      "sampleData": true,
      "baseUrl": "",
      "token": "",
      "entities": "",
      "screenshots": {
        "800x480": "./screenshots/home-assistant-sensors-default-800x480.png",
        "480x800": "./screenshots/home-assistant-sensors-default-480x800.png",
        "1600x1200": "./screenshots/home-assistant-sensors-default-1600x1200.png",
        "1200x1600": "./screenshots/home-assistant-sensors-default-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "baseUrl": "",
      "token": "",
      "entities": "",
      "screenshots": {
        "800x480": "./screenshots/home-assistant-sensors-dark-800x480.png",
        "480x800": "./screenshots/home-assistant-sensors-dark-480x800.png",
        "1600x1200": "./screenshots/home-assistant-sensors-dark-1600x1200.png",
        "1200x1600": "./screenshots/home-assistant-sensors-dark-1200x1600.png"
      }
    }
  ]
}
