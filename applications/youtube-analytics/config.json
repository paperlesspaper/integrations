{
  "name": "YouTube Analytics",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Channel views, watch time, subscriber growth and your newest video.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "red-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "accessToken": "",
    "refreshToken": "",
    "clientId": "",
    "clientSecret": "",
    "days": 7
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "accessToken": {
        "type": "string",
        "title": "Access token (or use refresh token below)",
        "default": "",
        "format": "password"
      },
      "refreshToken": {
        "type": "string",
        "title": "OAuth refresh token",
        "default": "",
        "format": "password"
      },
      "clientId": {
        "type": "string",
        "title": "OAuth client ID",
        "default": ""
      },
      "clientSecret": {
        "type": "string",
        "title": "OAuth client secret",
        "default": "",
        "format": "password"
      },
      "days": {
        "type": "number",
        "title": "Completed report days",
        "default": 7,
        "minimum": 1,
        "maximum": 30
      }
    }
  },
  "configVariants": [
    {
      "color": "red-light",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "accessToken": "",
      "refreshToken": "",
      "clientId": "",
      "clientSecret": "",
      "days": 7,
      "screenshots": {
        "800x480": "./screenshots/youtube-analytics-light-800x480.png",
        "480x800": "./screenshots/youtube-analytics-light-480x800.png",
        "1600x1200": "./screenshots/youtube-analytics-light-1600x1200.png",
        "1200x1600": "./screenshots/youtube-analytics-light-1200x1600.png"
      }
    },
    {
      "color": "red-dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "accessToken": "",
      "refreshToken": "",
      "clientId": "",
      "clientSecret": "",
      "days": 7,
      "screenshots": {
        "800x480": "./screenshots/youtube-analytics-dark-800x480.png",
        "480x800": "./screenshots/youtube-analytics-dark-480x800.png",
        "1600x1200": "./screenshots/youtube-analytics-dark-1600x1200.png",
        "1200x1600": "./screenshots/youtube-analytics-dark-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "accessToken": "",
      "refreshToken": "",
      "clientId": "",
      "clientSecret": "",
      "days": 7,
      "screenshots": {
        "800x480": "./screenshots/youtube-analytics-black-800x480.png",
        "480x800": "./screenshots/youtube-analytics-black-480x800.png",
        "1600x1200": "./screenshots/youtube-analytics-black-1600x1200.png",
        "1200x1600": "./screenshots/youtube-analytics-black-1200x1600.png"
      }
    }
  ]
}
