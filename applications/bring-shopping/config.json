      "timeZone": "Europe/Berlin",
      "email": "",
      "password": "",
      "listId": "",
      "screenshots": {
        "800x480": "./screenshots/bring-shopping-dark-800x480.png",
        "480x800": "./screenshots/bring-shopping-dark-480x800.png",
        "1600x1200": "./screenshots/bring-shopping-dark-1600x1200.png",
        "1200x1600": "./screenshots/bring-shopping-dark-1200x1600.png"
      }
    },
    {
      "color": "dark",
      "title": "",
