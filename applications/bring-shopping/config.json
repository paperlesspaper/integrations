{
  "name": "Bring! Shopping List",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Read a shared Bring! shopping list. Completed items are excluded.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
  "language": ["de", "en"],
  "nativeSettings": {
    "color": "green-light",
    "title": "",
    "sampleData": false,
    "timeZone": "Europe/Berlin",
    "email": "",
    "password": "",
    "listId": ""
  },
  "formSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Custom display title",
        "default": ""
      },
      "sampleData": {
        "type": "boolean",
        "title": "Use labelled demo data",
        "default": false
      },
      "timeZone": {
        "type": "string",
        "format": "timezone",
        "title": "Display time zone",
        "default": "Europe/Berlin"
      },
      "email": {
        "type": "string",
        "title": "Bring! account email",
        "default": "",
        "format": "email"
      },
      "password": {
        "type": "string",
        "title": "Bring! password",
        "default": "",
        "format": "password"
      },
      "listId": {
        "type": "string",
        "title": "List UUID (empty = first list)",
        "default": ""
      }
    }
  },
  "configVariants": [
    {
      "color": "green-light",
      "title": "",
      "sampleData": true,
      "timeZone": "Europe/Berlin",
      "email": "",
      "password": "",
      "listId": "",
      "screenshots": {
        "800x480": "./screenshots/bring-shopping-light-800x480.png",
        "480x800": "./screenshots/bring-shopping-light-480x800.png",
        "1600x1200": "./screenshots/bring-shopping-light-1600x1200.png",
        "1200x1600": "./screenshots/bring-shopping-light-1200x1600.png"
      }
    },
    {
      "color": "green-dark",
      "title": "",
