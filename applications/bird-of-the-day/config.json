    "showDiet": true,
    "showConservation": true,
    "showMigration": true,
    "showScientificName": false,
    "showHabitat": false,
    "showSize": false,
    "showNesting": false,
    "showOrder": false,
    "textSize": "middle",
    "showHeader": true,
    "showFactCount": false,
    "showRotationCount": false
  },
