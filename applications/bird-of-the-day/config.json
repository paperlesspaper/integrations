{
  "name": "Bird of the Day",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Shows one deterministic daily bird with clean side-profile artwork and compact Wikipedia-sourced facts.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "nativeSettings": {
    "color": "light",
    "region": "any",
    "habitat": "any",
    "birdId": "",
    "seed": "",
    "showRange": true,
