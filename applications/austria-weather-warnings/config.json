      },
      "latitude": {
        "type": "number",
        "default": 48.2082,
        "title": "Latitude",
        "minimum": 46,
        "maximum": 49.1
      },
      "longitude": {
        "type": "number",
        "default": 16.3738,
        "title": "Longitude",
        "minimum": 9.5,
        "maximum": 17.2
      },
      "includeUpcoming": {
        "type": "boolean",
        "default": true,
        "title": "Include upcoming warnings"
      }
    }
