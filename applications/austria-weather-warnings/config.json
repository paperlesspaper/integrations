{
  "name": "Austria Weather Warnings",
  "version": "0.1.0",
  "status": "alpha",
  "description": "Current and upcoming official GeoSphere warnings for one Austrian municipality.",
  "renderPage": "./render.html",
  "icon": "./assets/icon.png",
  "timezone": "Europe/Berlin",
